{
  "name": "mobomap",
  "version": "1.0.0",
  "private": true,
  "description": "Single-file map design studio – world countries with drill-down to regions, custom design systems, 24 styles, highlight groups, attributes, projections, PNG/JPG/PDF export, 10 UI languages.",
  "scripts": {
    "geo": "node tools/prepare-geo.mjs && node tools/prepare-admin1.mjs",
    "build": "node tools/build.mjs",
    "release": "node tools/release.mjs",
    "check": "node tools/check.mjs",
    "format": "prettier --write \"src/js/*.js\" src/app.css src/app.html \"tools/*.mjs\""
  },
  "devDependencies": {
    "mapshaper": "^0.6.0",
    "prettier": "^3.9.10"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/morbobon/MoboMap.git"
  },
  "keywords": [
    "map",
    "denmark",
    "municipalities",
    "world",
    "countries",
    "svg",
    "design-system",
    "poster",
    "export",
    "pdf"
  ]
}
